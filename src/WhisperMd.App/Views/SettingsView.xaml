<UserControl x:Class="WhisperMd.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="38,32,38,34" MaxWidth="850" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Настройки" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Margin="0,7,0,0"
                               Text="Параметры сохраняются между запусками и применяются к новой очереди." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ResetCommand}"
                            Content="Сбросить" />
                    <Button Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveCommand}"
                            Content="Сохранить" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Padding="22"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Транскрибация" />

                        <TextBlock Margin="0,18,0,6" FontFamily="Segoe UI Semibold" FontSize="13" Text="Язык" />
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Language, Mode=TwoWay}" />

                        <TextBlock Margin="0,16,0,6" FontFamily="Segoe UI Semibold" FontSize="13" Text="Вычислительный backend" />
                        <ComboBox ItemsSource="{Binding BackendOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Backend, Mode=TwoWay}" />

                        <TextBlock Margin="0,16,0,6" FontFamily="Segoe UI Semibold" FontSize="13" Text="Модель" />
                        <TextBox IsReadOnly="True" Text="small · ggml-small.bin" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Расширенные параметры" />

                        <TextBlock Margin="0,18,0,6" FontFamily="Segoe UI Semibold" FontSize="13" Text="Потоки CPU" />
                        <TextBox Text="{Binding Threads, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Используется CPU и CPU fallback. Допустимо 1–32." />

                        <TextBlock Margin="0,16,0,6" FontFamily="Segoe UI Semibold" FontSize="13" Text="Prompt по умолчанию" />
                        <TextBox MinHeight="102"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Text="{Binding DefaultPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Padding="22"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Библиотека заметок" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Margin="0,5,0,14"
                               Text="Новые Markdown-файлы сохраняются сюда. История хранит индекс и ссылки на эти файлы." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding LibraryDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding BrowseLibraryCommand}"
                                Content="Выбрать" />
                        <Button Grid.Column="4"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenLibraryCommand}"
                                Content="Открыть" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="6"
                    Padding="12,9"
                    Background="{StaticResource SurfaceMutedBrush}"
                    CornerRadius="8">
                <TextBlock Style="{StaticResource MutedTextStyle}"
                           TextWrapping="Wrap"
                           Text="{Binding StatusText}" />
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
